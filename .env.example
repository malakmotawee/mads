# Copy to .env (untracked) and fill in. Every value here is a placeholder.

# --- LLM (OpenAI-compatible) ---
# Leave LLM_API_KEY empty to run fully local on Ollama (gpt-oss:20b).
# For the free OpenRouter model, paste a key from https://openrouter.ai/keys
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-oss-120b:free
# Fall back to Ollama if the remote endpoint fails (rate limit, bad key).
# Set to false to never start or download a local model.
LLM_FALLBACK_TO_OLLAMA=true
# Free only: config.py refuses OpenRouter ids without ":free" unless this is true
ALLOW_PAID_MODEL=false
# Only for paid models: price used to compute "cost" in decision_log.json
LLM_USD_PER_1M_TOKENS=0

# --- Local model (Ollama) ---
# docker-compose.yml overrides this to http://ollama:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gpt-oss:20b

# --- Web search (ddgs, no key) ---
SEARCH_MAX_RESULTS=8
SEARCH_PAUSE_SECONDS=1.5

# --- Paths ---
OUTPUTS_DIR=outputs
DECISION_LOG_PATH=decision_log.json
